# Copy this file to .env and fill in the values. Never commit .env.

# Solana data (helius.dev -> API Keys)
HELIUS_API_KEY=

# Supabase (Dashboard -> Settings -> API Keys)
SUPABASE_URL=
SUPABASE_ANON_KEY=            # publishable key (safe for frontend)
SUPABASE_SERVICE_ROLE_KEY=    # secret key: backend only, never in frontend
SUPABASE_DB_PASSWORD=

# Gateway
GATEWAY_PORT=8080
ALLOWED_ORIGIN=http://localhost:3000

# Frontend (apps/web/.env.local)
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
