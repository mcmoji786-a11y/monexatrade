# Copy this file to .env and fill in the values. Never commit .env.

# Solana data (helius.dev -> API Keys)
HELIUS_API_KEY=

# Supabase (Dashboard -> Settings -> API Keys)
SUPABASE_URL=
SUPABASE_ANON_KEY=            # publishable key (safe for frontend)
SUPABASE_SERVICE_ROLE_KEY=    # secret key: backend only, never in frontend
SUPABASE_DB_PASSWORD=

# Gateway
GATEWAY_PORT=8080
ALLOWED_ORIGIN=http://localhost:3000

# Frontend (apps/web/.env.local)
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Kixo News (optional). Without these, news sites, Google News and on-chain events still work.
# X recent search needs a paid X API plan: https://developer.x.com
X_BEARER_TOKEN=
# Reddit needs an app (type "script" or "web"): https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Kixo's own fallback when Helius is down or its quota is used up (optional).
# Comma-separated; Solana's free public node is used when these are empty.
# Add free plans from other providers (Alchemy, QuickNode, Chainstack) for more headroom.
FALLBACK_RPC_URLS=
FALLBACK_WS_URLS=

# Admin (apps/web /admin-preview). ADMIN_TOKEN: a long random secret, 16+ characters.
# OWNER_EMAIL: the founder's Kixo account email; money and API-key changes in the admin
# need a code sent here. Both are read only from this file, never from the admin itself.
ADMIN_TOKEN=
OWNER_EMAIL=
