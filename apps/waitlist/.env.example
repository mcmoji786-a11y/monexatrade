# Kixo waitlist. Copy to .env.local (never commit it).
# The same Supabase project as Kixo; apply supabase/migrations/0010_waitlist.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile (free): https://dash.cloudflare.com → Turnstile → Add site.
# Leave both empty to run without the bot check (local testing only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# The waitlist's own address, for referral links (e.g. https://kixo.trade).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Welcome email after joining (your SMTP). Empty = no email.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The sender, e.g. Kixo <hello@kixo.trade>
SMTP_FROM=
