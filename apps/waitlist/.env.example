# Kixo waitlist. Copy to .env.local (never commit it).
# The same Supabase project as the Kixo app; apply supabase/migrations/0019_waitlist_accounts.sql first.
# Public values (the browser signs in with these):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (reads and writes the list):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile, only when Supabase Auth has CAPTCHA on (the same site key as the app).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The waitlist's own address, for invite links (e.g. https://kixo.trade).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Welcome email after joining (your SMTP). Empty = no email.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The sender, e.g. Kixo <hello@kixo.trade>
SMTP_FROM=
